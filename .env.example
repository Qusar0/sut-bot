# Скопируйте этот файл в .env и заполните значения.
# .env не коммитится (см. .gitignore).

# Токен от @BotFather
BOT_TOKEN=

# Ключ шифрования паролей ЛК (Fernet). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# База данных: локально SQLite, на сервере PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Telegram ID администратора для алертов об ошибках парсинга
ADMIN_ID=

# Публичный адрес сервера для подписки на календарь (необязательно; без него — только файл .ics)
PUBLIC_URL=
WEB_PORT=8080

# Redis для состояний диалогов (необязательно; в docker-compose задан автоматически)
REDIS_URL=
# Вебхук вместо polling: нужен PUBLIC_URL с HTTPS. Секрет — любая длинная случайная строка
USE_WEBHOOK=false
WEBHOOK_SECRET=

# Пароль PostgreSQL для docker-compose
POSTGRES_PASSWORD=
