# Скопируйте этот файл в .env и заполните значения.
# .env не коммитится (см. .gitignore).

# Токен от @BotFather
BOT_TOKEN=

# Ключ шифрования паролей ЛК (Fernet). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# База данных: локально SQLite, на сервере PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Telegram ID администратора для алертов об ошибках парсинга
ADMIN_ID=
